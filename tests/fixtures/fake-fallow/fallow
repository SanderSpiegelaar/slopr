#!/bin/sh
# Prints $FAKE_FALLOW_DIR/<command>.json, or an empty envelope when it is unset.
# FAKE_FALLOW_EXIT sets the exit code.
case "$1" in
--version)
	echo "fallow ${FAKE_FALLOW_VERSION:-3.42.0}"
	echo "verified: yes (cache hit at .fallow-verified); fallow ${FAKE_FALLOW_VERSION:-3.42.0} signed"
	exit 0
	;;
--only) command=combined ;;
security | flags) command=$1 ;;
*) echo "fake-fallow: unsupported: $*" >&2; exit 2 ;;
esac
if [ -n "$FAKE_FALLOW_DIR" ]; then
	cat "$FAKE_FALLOW_DIR/$command.json" || exit 2
else
	echo '{}'
fi
exit "${FAKE_FALLOW_EXIT:-0}"
