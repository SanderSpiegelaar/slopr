---
source: tests/cli.rs
expression: "repo_report(\"rust-crate\", \"sarif\")"
---
{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "slopr",
          "version": "0.1.0",
          "rules": [
            {
              "id": "comment/agent-artifact",
              "shortDescription": {
                "text": "Agent chatter about its plan, spec or past edits"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "comment/narrative",
              "shortDescription": {
                "text": "Comment narrates what the code does"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "comment/section-divider",
              "shortDescription": {
                "text": "Decorative section divider comment"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "comment/step-numbered",
              "shortDescription": {
                "text": "Numbered step or phase header comment"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "comment/untracked-todo",
              "shortDescription": {
                "text": "TODO, FIXME, HACK or XXX without an issue reference"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "debug/leftover",
              "shortDescription": {
                "text": "Debug output or breakpoint left in library code"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "error/redundant-rethrow",
              "shortDescription": {
                "text": "Catch that only rethrows the same error"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "error/swallowed",
              "shortDescription": {
                "text": "Error handler that hides the failure"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "sec/hardcoded-secret",
              "shortDescription": {
                "text": "Hardcoded API key, token or private key"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "stub/placeholder-body",
              "shortDescription": {
                "text": "Function body left as a placeholder"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "suppress/invalid-directive",
              "shortDescription": {
                "text": "Suppression directive that is malformed, has no reason or names an unknown rule"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "test/tautological",
              "shortDescription": {
                "text": "Test assertion that always passes"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "text/invisible-unicode",
              "shortDescription": {
                "text": "Zero-width or bidi control character"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ts/unsafe-assertion",
              "shortDescription": {
                "text": "Type assertion to any, or a double assertion through unknown"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "debug/leftover",
          "level": "warning",
          "message": {
            "text": "`dbg!` left in library code"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/parse.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 5,
                  "endLine": 8,
                  "endColumn": 26
                }
              }
            }
          ],
          "partialFingerprints": {
            "slopr/v1": "2500100e173b0b06"
          }
        },
        {
          "ruleId": "stub/placeholder-body",
          "level": "warning",
          "message": {
            "text": "function body is only a placeholder"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/parse.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 13,
                  "startColumn": 5,
                  "endLine": 13,
                  "endColumn": 12
                }
              }
            }
          ],
          "partialFingerprints": {
            "slopr/v1": "f3e94c45d191ad15"
          }
        },
        {
          "ruleId": "comment/narrative",
          "level": "warning",
          "message": {
            "text": "narrative comment opener `this function`"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/store.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 4,
                  "startColumn": 1,
                  "endLine": 4,
                  "endColumn": 51
                }
              }
            }
          ],
          "partialFingerprints": {
            "slopr/v1": "978534012532e6b7"
          }
        },
        {
          "ruleId": "error/swallowed",
          "level": "error",
          "message": {
            "text": "`.ok()` discards the error"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/store.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 6,
                  "startColumn": 5,
                  "endLine": 6,
                  "endColumn": 45
                }
              }
            }
          ],
          "partialFingerprints": {
            "slopr/v1": "644a29ca1bf83e75"
          }
        }
      ]
    }
  ]
}
